# USG Ishimura Environment Configuration
NODE_ENV=development

# --- MongoDB Atlas credentials (all four required, server throws if missing) ---
MONGO_CEC_ADMIN=your_atlas_user
MONGO_CEC_PASS=your_atlas_password
MONGO_CEC_CONN=your_cluster_subdomain
MONGO_CEC_DB=USG_Ishimura

# --- Ports (do not swap: webpack proxies /api from SERVER_PORT -> APP_PORT) ---
APP_PORT=3842
SERVER_PORT=5376

# --- CORS: comma-separated allowed origins. Must include SERVER_PORT if
#     frontend ever bypasses the dev proxy and calls the API directly.
ALLOWED_ORIGINS=http://localhost:5376,http://localhost:3000

# --- Rate limit (optional overrides, defaults live in pipe.ts) ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
