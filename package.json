{
    "name": "cec",
    "version": "1.0.0",
    "description": "CEC_AEGIS_ISHIMURA",
    "main": "IshimuraDB.js",
    "private": true,
    "scripts": {
        "start": "npm-run-all --parallel server crew",
        "RIG": "nodemon CEC/archive/ships/USG_Ishimura/IshimuraDB.js",
        "server": "nodemon CEC/archive/ships/USG_Ishimura/bridge/server/server.js",
        "crew": "webpack serve --config webpack.config.js --mode development",
        "deck": "npm run compile && concurrently \"npm run server\" \"npm run crew\" \"npm run watch\"",
        "deck:override": "npm run compile && concurrently --kill-others \"npm run server\" \"npm run crew\"",
        "build": "webpack --config webpack.config.js --mode production",
        "compile": "npm-run-all --parallel compile-ts compile-scss",
        "compile-ts": "tsc --project tsconfig.build.json",
        "typecheck": "tsc --project tsconfig.json --noEmit",
        "compile-scss": "sass CEC/styles/styles.scss CEC/styles/styles.css",
        "watch": "npm-run-all --parallel watch-ts watch-scss",
        "watch-ts": "tsc --watch --project tsconfig.build.json",
        "watch-scss": "sass --watch CEC/styles/styles.scss:CEC/styles/styles.css",
        "test": "jest",
        "gen:rotation": "ts-node --transpile-only scripts/gen-rotation-snapshot.ts",
        "lint": "eslint '**/*.{js,jsx,ts,tsx}' --fix",
        "lint:check": "eslint '**/*.{js,jsx,ts,tsx}'",
        "prettier": "prettier --write '**/*.{js,jsx,ts,tsx,html,css,scss,json,md}'",
        "format": "npm run prettier && npm run lint",
        "prepare": "husky"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ChewBaccaYeti/DS_API.git"
    },
    "keywords": [
        "CEC",
        "Aegis",
        "Ishimura"
    ],
    "author": "Venedykt Mitishov (Isaac CLarke)",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/ChewBaccaYeti/DS_API/issues"
    },
    "homepage": "https://github.com/ChewBaccaYeti/DS_API#readme",
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,css,scss,html,yml,yaml}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@babel/node": "^7.26.0",
        "@epegzz/winston-dev-console": "^1.3.4",
        "@tanstack/react-query": "^5.101.2",
        "compression": "^1.8.1",
        "cors": "^2.8.5",
        "dompurify": "^3.1.7",
        "dotenv": "^16.4.5",
        "express": "^4.21.1",
        "express-rate-limit": "^8.2.2",
        "helmet": "^8.0.0",
        "lru-cache": "^11.5.2",
        "mermaid": "^11.16.0",
        "mongodb": "^6.9.0",
        "mongoose": "^8.22.1",
        "morgan": "^1.11.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^7.18.1",
        "swagger-ui-express": "^5.0.1",
        "web-vitals": "^2.1.4",
        "winston": "^3.19.0",
        "yamljs": "^0.3.0"
    },
    "devDependencies": {
        "@babel/cli": "^7.25.9",
        "@babel/core": "^7.26.0",
        "@babel/preset-env": "^7.26.0",
        "@babel/preset-react": "^7.28.5",
        "@babel/preset-typescript": "^7.26.0",
        "@eslint/js": "^9.14.0",
        "@tailwindcss/postcss": "^4.3.2",
        "@testing-library/jest-dom": "^5.17.0",
        "@testing-library/react": "^13.4.0",
        "@testing-library/user-event": "^13.5.0",
        "@types/compression": "^1.8.1",
        "@types/cors": "^2.8.17",
        "@types/dotenv": "^8.2.0",
        "@types/eslint__js": "^8.42.3",
        "@types/eslint-config-prettier": "^6.11.3",
        "@types/express": "^5.0.0",
        "@types/express-rate-limit": "^5.1.3",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.8.2",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@types/react-router-dom": "^5.3.3",
        "@types/swagger-ui-express": "^4.1.8",
        "@types/yamljs": "^0.2.34",
        "@typescript-eslint/eslint-plugin": "^8.13.0",
        "@typescript-eslint/parser": "^8.13.0",
        "babel-loader": "^9.2.1",
        "concurrently": "^9.1.0",
        "css-loader": "^7.1.2",
        "eslint": "^9.14.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-node": "^11.1.0",
        "eslint-plugin-prettier": "^5.2.1",
        "eslint-plugin-react": "^7.37.2",
        "globals": "^15.15.0",
        "html-webpack-plugin": "^5.6.3",
        "husky": "^9.1.7",
        "jest": "^29.7.0",
        "lint-staged": "^16.4.0",
        "mini-css-extract-plugin": "^2.9.1",
        "nodemon": "^3.1.7",
        "npm-run-all": "^4.1.5",
        "postcss": "^8.5.19",
        "postcss-loader": "^8.2.1",
        "prettier": "^3.3.3",
        "sass": "^1.101.0",
        "sass-loader": "^16.0.2",
        "style-loader": "^4.0.0",
        "tailwindcss": "^4.3.2",
        "ts-jest": "^29.4.11",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.13.0",
        "webpack": "^5.108.4",
        "webpack-cli": "^5.1.4",
        "webpack-dev-server": "^5.2.5"
    }
}
